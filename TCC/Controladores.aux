\@writefile{lof}{\contentsline {figure}{\numberline {5.3}{\ignorespaces Estrutura do algoritmo Super-Twisting (STA): a variável interna $z_i$ (Equação~\eqref  {eq:sta_z}) integra o sinal descontínuo $-k_{2,i}\,\text  {sign}(S_i)$, tornando $v_{\text  {sw},i}$ contínuo e eliminando o \textit  {chattering}. As condições de ganho $k_{2,i} > \delta _i$ e $k_{1,i} > 2\sqrt  {k_{2,i}\delta _i}$ garantem convergência em tempo finito \cite  {levant1993sliding, moreno2012strict}.}}{95}{figure.caption.24}\protected@file@percent }
\newlabel{fig:sta_ctrl}{{5.3}{95}{Estrutura do algoritmo Super-Twisting (STA): a variável interna $z_i$ (Equação~\eqref {eq:sta_z}) integra o sinal descontínuo $-k_{2,i}\,\text {sign}(S_i)$, tornando $v_{\text {sw},i}$ contínuo e eliminando o \textit {chattering}. As condições de ganho $k_{2,i} > \delta _i$ e $k_{1,i} > 2\sqrt {k_{2,i}\delta _i}$ garantem convergência em tempo finito \cite {levant1993sliding, moreno2012strict}}{figure.caption.24}{}}
