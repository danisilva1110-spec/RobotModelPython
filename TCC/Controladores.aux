\def\@LN@column{1}
\@writefile{lof}{\contentsline {figure}{\numberline {5.5}{\ignorespaces Lei de controle do LADRC (Equações~\eqref  {eq:adrc_u0_cap5}--\eqref  {eq:ladrc_ctrl_cap5}): o distúrbio estimado $z_{3,i}^{\text  {filt}}$ é subtraído da ação de controle PD $u_{0,i}$ e o resultado é dividido por $b_{0,i}$; o \textit  {feedforward} explícito de $G_i$ e $C_i$ reduz o distúrbio residual que o ESO precisa rastrear \cite  {han2009pid, huang2014active, gao2003scaling}.}}{101}{figure.caption.26}\protected@file@percent }
