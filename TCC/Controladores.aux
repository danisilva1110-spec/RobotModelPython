\@writefile{lof}{\contentsline {figure}{\numberline {5.2}{\ignorespaces Estrutura do Controle por Modo Deslizante com Torque Computado (CT-SMC): o sinal de chaveamento $-K\tanh (S/\phi )$ garante a condição de alcance $\dot  {V}_i < 0$ para perturbações $\|d_i\| \leq K_i$ (Equação~\eqref  {eq:lyap_smc}). O filtro passa-baixas de $\ddot  {q}_{d,f}$ previne amplificação de picos de aceleração do CLIK \cite  {slotine1991applied, burton1986continuous}.}}{91}{figure.caption.23}\protected@file@percent }
\newlabel{fig:ct_smc}{{5.2}{91}{Estrutura do Controle por Modo Deslizante com Torque Computado (CT-SMC): o sinal de chaveamento $-K\tanh (S/\phi )$ garante a condição de alcance $\dot {V}_i < 0$ para perturbações $\|d_i\| \leq K_i$ (Equação~\eqref {eq:lyap_smc}). O filtro passa-baixas de $\ddot {q}_{d,f}$ previne amplificação de picos de aceleração do CLIK \cite {slotine1991applied, burton1986continuous}}{figure.caption.23}{}}
